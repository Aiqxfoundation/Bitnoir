# Clerk values are managed through Replit Auth/Secrets. Never commit their values.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Optional when a Clerk proxy URL is explicitly configured for the frontend.
VITE_CLERK_PROXY_URL=

# Set to the authenticated Clerk user ID selected as the one-time Super Admin.
# This is a deployment setting, not a password or API key.
BITNOIR_SUPER_ADMIN_CLERK_USER_ID=

# BNB Smart Chain mainnet. Both values are required to enable deposit review.
BITNOIR_TREASURY_ADDRESS=
# If the RPC provider URL contains a credential, store it in Replit Secrets.
BITNOIR_BSC_RPC_URL=

# Basis points; 200 = 2%. Allowed range: 0–2500 (0–25%).
BITNOIR_WITHDRAWAL_FEE_BPS=200

# Optional structured log level.
LOG_LEVEL=info

# Replit supplies DATABASE_URL for the configured database at runtime.
# Do not copy a database connection string into this file.
